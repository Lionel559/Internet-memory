{
  "manifest_version": 3,
  "name": "Internet Memory",
  "version": "1.0.0",
  "description": "Save and search your browsing memory with AI.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internet Memory",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}